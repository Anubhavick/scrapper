# Postgres (compose service + app connection)
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen
POSTGRES_DB=leadgen
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://leadgen:leadgen@localhost:5432/leadgen

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Gmail OAuth (per mailbox; loaded by the send package, not committed)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encryption key for OAuth refresh tokens at rest
TOKEN_ENCRYPTION_KEY=

# Nominatim / Overpass identify ourselves per their usage policy
CRAWLER_USER_AGENT="leadgen-bot/0.1 (+contact: you@example.com)"

# Web UI login (HTTP Basic, one shared credential for the whole team --
# see docs/17). Required: the app raises rather than serving any page
# without both of these set. Pick your own values, don't reuse this file's.
WEB_UI_USERNAME=
WEB_UI_PASSWORD=
